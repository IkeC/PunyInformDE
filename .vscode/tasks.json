{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PunyInformDE Build (Windows)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File build.ps1",
      "options": {
        "cwd": "${workspaceFolder}\\build"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": {
        "owner": "inform6",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+)\\((\\d+)\\):\\s+(Error|Warning|Fatal):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      }
    },
    {
      "label": "PunyInformDE Test Sterne (Windows Dfrotz)",
      "type": "shell",
      "command": "chcp 65001 > nul && tools\\dfrotz.exe build\\sterne.z5",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "cmd.exe",
          "args": [
            "/d",
            "/s",
            "/c"
          ]
        }
      },
      "dependsOn": [
        "PunyInformDE Build (Windows)"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "PunyInformDE Test Sterne (Windows Lectrote)",
